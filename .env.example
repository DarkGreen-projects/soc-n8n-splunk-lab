# Copy to C:\lab\.env (lab-up.ps1 also syncs from secrets\.env)
# Generate strong values before first start.

POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=change-me-32-char-min-random-string
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

GENERIC_TIMEZONE=Europe/Rome
TZ=Europe/Rome

# Splunk Free (max 500 MB/day indexed). Password min 8 chars.
SPLUNK_PASSWORD=change-me-splunk-password
SPLUNK_USER=admin
# Used by n8n on Docker network (lab_splunk). Host debug: https://localhost:8089
SPLUNK_URL=https://lab_splunk:8089
# Optional: set a fixed HEC token for HTTP Event Collector (or leave empty)
SPLUNK_HEC_TOKEN=lab-hec-change-me

# Ollama (AI triage summary in n8n poller)
OLLAMA_URL=http://lab_ollama:11434
OLLAMA_MODEL=llama3.2:1b
